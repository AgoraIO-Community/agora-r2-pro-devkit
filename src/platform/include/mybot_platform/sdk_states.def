/* SDK state, application.status during an SDK session, and UI terminal text.
 * The controller publishes startup gates and final shutdown separately. */
RV1126B_SDK_STATE(MYBOT_STATE_STOPPED, RV1126B_APP_STARTING_SERVICES, "stopped")
RV1126B_SDK_STATE(MYBOT_STATE_WIFI_PROVISIONING, RV1126B_APP_STARTING_SERVICES, "waiting_network")
RV1126B_SDK_STATE(MYBOT_STATE_STARTING_SERVICES, RV1126B_APP_STARTING_SERVICES, "starting_services")
RV1126B_SDK_STATE(MYBOT_STATE_READY, RV1126B_APP_READY, "ready")
RV1126B_SDK_STATE(MYBOT_STATE_WIFI_DISCONNECTED, RV1126B_APP_OFFLINE, "offline")
RV1126B_SDK_STATE(MYBOT_STATE_FAILED, RV1126B_APP_FAILED, "failed")
RV1126B_SDK_STATE(MYBOT_STATE_STOPPING, RV1126B_APP_STARTING_SERVICES, "stopping")
RV1126B_SDK_STATE(MYBOT_STATE_IN_CONVERSATION, RV1126B_APP_CONVERSATION, "in_conversation")
RV1126B_SDK_STATE(MYBOT_STATE_PAIRING, RV1126B_APP_PAIRING, "pairing")
