set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(RV1126B_CROSS_COMPILE "$ENV{CROSS_COMPILE}" CACHE STRING "Target compiler prefix")
set(RV1126B_STAGING "$ENV{RV1126B_STAGING}" CACHE PATH "Target dependency headers/runtime")
set(RV1126B_SYSROOT "$ENV{RV1126B_SYSROOT}" CACHE PATH "Optional complete development sysroot")
if(NOT RV1126B_CROSS_COMPILE OR NOT IS_DIRECTORY "${RV1126B_STAGING}")
    message(FATAL_ERROR "Set CROSS_COMPILE and RV1126B_STAGING, or run scripts/configure-local-sdk.py")
endif()
find_program(CMAKE_C_COMPILER NAMES "${RV1126B_CROSS_COMPILE}gcc" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES "${RV1126B_CROSS_COMPILE}g++" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(CMAKE_AR NAMES "${RV1126B_CROSS_COMPILE}ar" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
find_program(CMAKE_RANLIB NAMES "${RV1126B_CROSS_COMPILE}ranlib" NO_CMAKE_FIND_ROOT_PATH REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_C_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_CXX_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_CXX_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_FIND_ROOT_PATH "${RV1126B_STAGING}")
if(RV1126B_SYSROOT)
    if(NOT IS_DIRECTORY "${RV1126B_SYSROOT}/usr/include")
        message(FATAL_ERROR "RV1126B_SYSROOT must include libc development files")
    endif()
    set(CMAKE_SYSROOT "${RV1126B_SYSROOT}")
    list(APPEND CMAKE_FIND_ROOT_PATH "${RV1126B_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY FALSE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY FALSE)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    RV1126B_CROSS_COMPILE RV1126B_STAGING RV1126B_SYSROOT)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${RV1126B_STAGING}/usr/lib -L${RV1126B_STAGING}/lib")
execute_process(COMMAND "${CMAKE_C_COMPILER}" --version OUTPUT_VARIABLE RV1126B_COMPILER_VERSION)
if(NOT RV1126B_COMPILER_VERSION MATCHES "zig-bootstrap")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT
        " -Wl,-rpath-link,${RV1126B_STAGING}/usr/lib -Wl,-rpath-link,${RV1126B_STAGING}/lib")
endif()
