################################################################################
#
# botstation-device
#
################################################################################

BOTSTATION_DEVICE_VERSION = $(shell cat $(BR2_EXTERNAL_AGORA_R2_PRO_PATH)/../../VERSION)
BOTSTATION_DEVICE_SITE = $(BR2_EXTERNAL_AGORA_R2_PRO_PATH)/../..
BOTSTATION_DEVICE_SITE_METHOD = local
BOTSTATION_DEVICE_LICENSE = Apache-2.0
BOTSTATION_DEVICE_LICENSE_FILES = LICENSE
BOTSTATION_DEVICE_DEPENDENCIES = alsa-lib openssl

BOTSTATION_DEVICE_RTSA_SDK_DIR = $(call qstrip,$(BR2_PACKAGE_BOTSTATION_DEVICE_RTSA_SDK_DIR))
BOTSTATION_DEVICE_RTSA_LIBRARY = $(call qstrip,$(BR2_PACKAGE_BOTSTATION_DEVICE_RTSA_LIBRARY))
ifeq ($(BOTSTATION_DEVICE_RTSA_LIBRARY),)
BOTSTATION_DEVICE_RTSA_LIBRARY = $(BOTSTATION_DEVICE_RTSA_SDK_DIR)/lib/aarch64/libagora-rtc-sdk.so
endif

ifeq ($(BR2_PACKAGE_BOTSTATION_DEVICE_PTIME_20),y)
BOTSTATION_DEVICE_PTIME = 20
else ifeq ($(BR2_PACKAGE_BOTSTATION_DEVICE_PTIME_40),y)
BOTSTATION_DEVICE_PTIME = 40
else
BOTSTATION_DEVICE_PTIME = 60
endif

BOTSTATION_DEVICE_CONF_OPTS += \
	-DAGORA_SDK_DIR=$(BOTSTATION_DEVICE_RTSA_SDK_DIR) \
	-DAGORA_RTC_LIBRARY=$(BOTSTATION_DEVICE_RTSA_LIBRARY) \
	-DMYBOT_AUDIO_PTIME_MS=$(BOTSTATION_DEVICE_PTIME) \
	-DMYBOT_ENABLE_VIDEO=$(if $(BR2_PACKAGE_BOTSTATION_DEVICE_VIDEO),ON,OFF) \
	-DBOTSTATION_ENABLE_LVGL_UI=$(if $(BR2_PACKAGE_BOTSTATION_DEVICE_LVGL_UI),ON,OFF) \
	-DBOTSTATION_BUILD_TESTS=OFF

define BOTSTATION_DEVICE_INSTALL_VIDEO_MARKER
	$(INSTALL) -D -m 0644 /dev/null \
		$(TARGET_DIR)/etc/botstation-video-capture
endef

ifneq ($(BR2_PACKAGE_BOTSTATION_DEVICE_VIDEO),)
BOTSTATION_DEVICE_POST_INSTALL_TARGET_HOOKS += BOTSTATION_DEVICE_INSTALL_VIDEO_MARKER
endif

$(eval $(cmake-package))
